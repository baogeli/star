package main

import (
	"context"
	"fmt"
	_ "github.com/gogf/gf/contrib/drivers/mysql/v2"
	"github.com/gogf/gf/v2/frame/g"
	"math"
	"star/internal/dao"
	"star/internal/model/entity"
)

/*

	288个交易日，按周计算beta不足5天的都丢弃
	ln() 自然对数  以数学常数‌ e ≈ 2.71828 为底数

*/

func main() {
	ctx := context.Background()
	var benchMark []*entity.PyT
	// 市场基准用的上证指数
	err := dao.PyT.Ctx(ctx).
		Where(dao.PyT.Columns().FundCode, "000001").
		Limit(15).
		OrderAsc(dao.PyT.Columns().CreateTime).Scan(&benchMark)
	if err != nil {
		return
	}
	// 按周计算对数收益率
	weeklyLogReturns := calculateWeeklyLogReturns(benchMark)
	for i, ret := range weeklyLogReturns {
		fmt.Printf("上证指数 第 %d 周对数收益率: %.6f (即 %.4f%%)\n", i+1, ret, ret*100)
	}

	// 按周计算数收益率
	var myStocks []*entity.PyT
	err = dao.PyT.Ctx(ctx).Where(dao.PyT.Columns().FundCode, "688001").
		Limit(15).
		OrderAsc(dao.PyT.Columns().CreateTime).Scan(&myStocks)
	if err != nil {
		return
	}
	weeklyMyStocksReturns := calculateWeeklyLogReturns(myStocks)
	for i, ret := range weeklyMyStocksReturns {
		fmt.Printf("华兴源创 第 %d 周对数收益率: %.6f (即 %.4f%%)\n", i+1, ret, ret*100)
	}

	// 计算 Beta 值 (股票相对于市场基准)
	beta := calculateBeta(weeklyMyStocksReturns, weeklyLogReturns)
	g.Log().Infof(nil, "688001 相对于上证指数的周 Beta 值: %.4f", beta)

}

// calculateWeeklyLogReturns 按周计算对数收益率
func calculateWeeklyLogReturns(data []*entity.PyT) []float64 {
	if len(data) < 5 {
		return []float64{}
	}

	var weeklyReturns []float64
	weekStart := 0

	// 每5个交易日为一周
	for weekStart+4 < len(data) {
		weekEnd := weekStart + 4

		startPrice := data[weekStart].CurrentPrice
		endPrice := data[weekEnd].CurrentPrice
		//g.Log().Infof(nil, "startdate : %s :startPrice: %.3f, endData : %s  endPrice: %.3f", data[weekStart].CreateTime.Format("Y-m-d"), startPrice, data[weekEnd].CreateTime.Format("Y-m-d"), endPrice)

		if startPrice > 0 && endPrice > 0 {
			// 对数收益率 = ln(期末价格 / 期初价格)
			logReturn := math.Log(endPrice / startPrice)
			weeklyReturns = append(weeklyReturns, logReturn)
		}

		weekStart += 5
	}

	return weeklyReturns
}

// calculateBeta 计算 Beta 系数
// 简化公式: Beta = [N·Σ(Xi·Yi) - (ΣXi)(ΣYi)] / [N·Σ(Xi²) - (ΣXi)²]
// returns: 投资组合(股票)收益率序列 (Y)
// benchmarkReturns: 市场基准收益率序列 (X)
func calculateBeta(returns, benchmarkReturns []float64) float64 {
	if len(returns) != len(benchmarkReturns) || len(returns) < 2 {
		g.Log().Errorf(nil, "收益率数组长度不一致或数据不足: stock=%d, benchmark=%d", len(returns), len(benchmarkReturns))
		return 0
	}

	n := float64(len(returns))

	// 一次性计算所有需要的累加值
	var sumX, sumY, sumXY, sumX2 float64
	for i := 0; i < len(returns); i++ {
		x := benchmarkReturns[i] // 市场基准
		y := returns[i]          // 股票收益
		sumX += x
		sumY += y
		sumXY += x * y
		sumX2 += x * x
		//g.Log().Infof(nil, "n: %f, x: %f, y: %f", n, x, y)
	}

	// 应用简化公式

	//g.Log().Infof(nil, "sumX: %f, sumY: %f, sumXY: %f, sumX2: %f", sumX, sumY, sumXY, sumX2)

	numerator := n*sumXY - sumX*sumY   // 分子: N·Σ(Xi·Yi) - (ΣXi)(ΣYi)
	denominator := n*sumX2 - sumX*sumX // 分母: N·Σ(Xi²) - (ΣXi)²

	// 防止除以零
	if denominator < 1e-8 {
		return 0
	}

	beta := numerator / denominator
	return float64(int(beta*10000)) / 10000 // 保留4位小数
}
